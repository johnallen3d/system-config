#!/usr/bin/env python3
"""Transport a Git-based deployment to Omarchy; never transport host profiles."""

import base64
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time

import deployment_state as coordination

# Apple SSH supports macOS Keychain directives that portable OpenSSH rejects.
# Select it explicitly: a caller (including a Nix wrapper) may prepend Nix SSH.
SSH = ["/usr/bin/ssh" if sys.platform == "darwin" else "ssh",
       "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
       "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3",
       "johna@omarchy", "bash -s"]


def run(*args, cwd=None, env=None):
    return subprocess.check_output(args, cwd=cwd, env=env, text=True).strip()


def git(repo, *args):
    return run("git", "-C", str(repo), *args)


def source_tree(repo):
    # A private index includes new, nonignored source without staging anything
    # in the user's real index. Ignored files, profiles, and .git stay behind.
    with tempfile.TemporaryDirectory(prefix="update-system-index-") as directory:
        env = dict(os.environ, GIT_INDEX_FILE=str(Path(directory) / "index"))
        run("git", "-C", str(repo), "read-tree", "HEAD", env=env)
        run("git", "-C", str(repo), "add", "-A", "--", ".", env=env)
        return run("git", "-C", str(repo), "write-tree", env=env)


def prepare(repo, directory, planned_source=None):
    repo = repo.resolve()
    main = git(repo, "rev-parse", "refs/heads/main")
    if planned_source is not None:
        planned = json.loads((coordination.state_dir() / "pending.json").read_text())
        if planned["main"] != main or planned["source"] != str(planned_source):
            raise RuntimeError("Main/source changed after Mac planning; retry before either host starts")
        coordination.validate(repo, planned, require_source=True)
    if git(repo, "ls-files", "--unmerged"):
        raise RuntimeError("Resolve local Git conflicts before deploying")
    tree = source_tree(repo)
    manifest = {"main": main, "tree": tree, "layer": coordination.layer(repo)}
    manifest["slug"] = "update-system-" + hashlib.sha256(f"{main}:{tree}".encode()).hexdigest()[:12]
    (directory / "manifest.json").write_text(json.dumps(manifest))
    subprocess.run(["git", "-C", str(repo), "bundle", "create", str(directory / "main.bundle"),
                    "refs/heads/main"], check=True)
    with (directory / "source.patch").open("wb") as output:
        subprocess.run(["git", "-C", str(repo), "diff", "--no-ext-diff", "--no-textconv", "--no-color", "--no-relative",
                        "--src-prefix=a/", "--dst-prefix=b/", "--binary", "--full-index", main, tree, "--"],
                       stdout=output, check=True)
    shutil.copyfile(__file__, directory / "worker.py")
    shutil.copyfile(Path(__file__).with_name("deployment_state.py"), directory / "deployment_state.py")
    print(f"[Omarchy] Prepared source {tree[:12]} on main {main[:12]}", flush=True)


def deploy(directory):
    archive = directory / "payload.tar.gz"
    with tarfile.open(archive, "w:gz") as output:
        for name in ("main.bundle", "source.patch", "manifest.json", "worker.py", "deployment_state.py"):
            output.add(directory / name, arcname=name)
    # Fish is the login shell. Run Bash explicitly, with no local profile/env
    # variables or credentials serialized into the remote command.
    script = """set -euo pipefail
[ "$(uname -s)" = Linux ] && [ "$HOME" = /home/johna ]
directory=$(mktemp -d)
trap 'rm -rf "$directory"' EXIT
base64 --decode <<'UPDATE_SYSTEM_PAYLOAD' | tar -xzf - -C "$directory"
""" + base64.b64encode(archive.read_bytes()).decode() + "\nUPDATE_SYSTEM_PAYLOAD\n" + \
        'python3 "$directory/worker.py" remote "$directory"\n'
    subprocess.run(SSH, input=script, text=True, check=True)


def verify_files(generation):
    root = (generation / "home-files").resolve()
    checked = 0
    for parent, dirs, files in os.walk(root, followlinks=False):
        links = [name for name in dirs if (Path(parent) / name).is_symlink()]
        dirs[:] = [name for name in dirs if name not in links]
        for name in files + links:
            expected = Path(parent) / name
            relative = expected.relative_to(root)
            actual = Path.home() / relative
            if not actual.exists():
                raise RuntimeError(f"Installed managed file is missing/broken: {relative}")
            if actual.resolve() != expected.resolve():
                if not (actual.is_file() and expected.is_file() and actual.read_bytes() == expected.read_bytes()):
                    raise RuntimeError(f"Installed managed file differs: {relative}")
            checked += 1
    print(f"[Omarchy] Verified {checked} installed managed entries", flush=True)


def check_nix_system(task):
    # Root-owned daemon settings sit outside Home Manager; report drift without
    # failing an otherwise verified activation (fix: sudo bash SCRIPT apply).
    script = task / ".mise/scripts/omarchy-nix-system"
    if not script.exists():
        return
    result = subprocess.run(["bash", str(script), "check"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if result.returncode:
        for line in result.stdout.splitlines():
            print(f"[Omarchy] WARNING: Nix system drift: {line}", flush=True)
        print(f"[Omarchy] WARNING: run: sudo bash {script} apply", flush=True)
    else:
        print("[Omarchy] Verified Nix system settings", flush=True)


def receive(directory, repo):
    manifest = json.loads((directory / "manifest.json").read_text())
    main, tree, slug = (manifest[key] for key in ("main", "tree", "slug"))
    expected_slug = "update-system-" + hashlib.sha256(f"{main}:{tree}".encode()).hexdigest()[:12]
    if slug != expected_slug or any(len(value) != 40 or any(c not in "0123456789abcdef" for c in value)
                                    for value in (main, tree)):
        raise RuntimeError("Invalid source manifest")
    worktrees = git(repo, "worktree", "list", "--porcelain")
    if worktrees.splitlines()[0] != f"worktree {repo.resolve()}":
        raise RuntimeError("Omarchy deployment repository must be its primary checkout")
    if git(repo, "symbolic-ref", "--short", "HEAD") != "main":
        raise RuntimeError("Omarchy primary checkout is not on main; refusing to switch it")
    if git(repo, "status", "--porcelain", "--untracked-files=all"):
        raise RuntimeError("Omarchy primary checkout has changes; preserve/reconcile them first")
    git(repo, "bundle", "verify", str(directory / "main.bundle"))
    bundled = git(repo, "bundle", "list-heads", str(directory / "main.bundle"), "refs/heads/main")
    if bundled != f"{main} refs/heads/main":
        raise RuntimeError("Bundle does not match the declared main")
    git(repo, "bundle", "unbundle", str(directory / "main.bundle"))
    old_main = git(repo, "rev-parse", "refs/heads/main")
    if subprocess.run(["git", "-C", str(repo), "merge-base", "--is-ancestor", old_main, main]).returncode:
        raise RuntimeError("Omarchy main is ahead or diverged; reconcile history before deployment")
    if old_main != main:
        # Only integrated local main is synchronized, never a task branch.
        git(repo, "merge", "--ff-only", "--no-overwrite-ignore", main)
        print(f"[Omarchy] Fast-forwarded main {old_main[:12]} -> {main[:12]}", flush=True)
    # Reconstruct the incoming tree in this repository's object database. A
    # private index applies the patch without a transport checkout or branch.
    with tempfile.TemporaryDirectory(prefix="update-system-index-") as index:
        env = dict(os.environ, GIT_INDEX_FILE=str(Path(index) / "index"))
        run("git", "-C", str(repo), "read-tree", main, env=env)
        if (directory / "source.patch").stat().st_size:
            run("git", "-C", str(repo), "apply", "--cached", "--binary",
                str(directory / "source.patch"), env=env)
        if run("git", "-C", str(repo), "write-tree", env=env) != tree:
            raise RuntimeError("Transported source does not match its declared tree")
    git(repo, "update-ref", f"refs/system-config/trees/{tree}", tree)
    print(f"[Omarchy] Received source tree {tree[:12]} (no transport worktree)", flush=True)
    return repo, tree


def remote(directory):
    with coordination.lock(coordination.state_dir(), "Omarchy: " + str(json.loads((directory / "manifest.json").read_text())["layer"]["owner"])), coordination.temporary_sources():
        remote_locked(directory)


def remote_locked(directory):
    if sys.platform != "linux" or str(Path.home()) != "/home/johna":
        raise RuntimeError("Unexpected remote host/user")
    repo, tree = receive(directory, Path.home() / "dev/src/system-config")
    incoming = json.loads((directory / "manifest.json").read_text())["layer"]
    if incoming["tree"] != tree:
        raise RuntimeError("Task ownership layer does not match transported source")
    record = coordination.plan(repo, coordination.state_dir(), incoming)
    activate_omarchy(repo, record)


def local(repo):
    if sys.platform != "linux" or str(Path.home()) != "/home/johna":
        raise RuntimeError("Unexpected Linux deployment host/user")
    with coordination.lock(coordination.state_dir(), str(repo)), coordination.temporary_sources():
        activate_omarchy(repo, coordination.plan(repo, coordination.state_dir()))


def activate_omarchy(repo, record):
    task, tree = Path(record["source"]), record["tree"]
    logs = Path.home() / ".local/state/system-config/logs"
    logs.mkdir(parents=True, exist_ok=True)
    log = logs / f"update-system-{time.time_ns()}.log"
    print(f"[Omarchy] Home Manager log: {log}", flush=True)
    context = ["mise", "-C", str(Path.home() / "dev/src/amfaro"), "exec", "--"]
    env = dict(os.environ, NIX_CONFIG=os.environ.get("NIX_CONFIG", "") +
               "\nextra-experimental-features = nix-command flakes")
    with log.open("w") as output:
        result = subprocess.run(context + ["nix", "--extra-experimental-features", "nix-command flakes",
                                          "build", "--no-update-lock-file", "--no-write-lock-file", "--no-link", "--print-out-paths",
                                          f'path:{task}#homeConfigurations."johna@omarchy".activationPackage'],
                                stdout=subprocess.PIPE, stderr=output, text=True, env=env)
        if result.returncode:
            raise RuntimeError(f"Omarchy build failed (exit {result.returncode}); inspect {log}")
        generation = Path(result.stdout.strip())
        if generation.parent != Path("/nix/store") or not generation.name.endswith("-home-manager-generation"):
            raise RuntimeError(f"Unexpected build output; inspect {log}")
        coordination.preactivate(repo, coordination.state_dir())
        if coordination.snapshot_tree(repo, task) != tree:
            raise RuntimeError("Deployment source changed before activation")
        subprocess.run(context + [str(generation / "activate")], stdout=output, stderr=output, env=env, check=True)
    active = (Path.home() / ".local/state/nix/profiles/home-manager").resolve()
    if active != generation:
        raise RuntimeError(f"Activation did not select the built generation; inspect {log}")
    if coordination.snapshot_tree(repo, task) != tree:
        raise RuntimeError(f"Source changed during deployment: {task}")
    verify_files(generation)
    check_nix_system(task)
    coordination.finish(repo, coordination.state_dir())
    print(f"[Omarchy] Active generation: {generation}", flush=True)


def main():
    mode = sys.argv[1]
    if mode == "prepare":
        prepare(Path(sys.argv[2]), Path(sys.argv[3]), Path(sys.argv[4]) if len(sys.argv) > 4 else None)
    elif mode == "deploy":
        deploy(Path(sys.argv[2]))
    elif mode == "remote":
        remote(Path(sys.argv[2]))
    elif mode == "local":
        local(Path(sys.argv[2]).resolve())
    elif mode == "check":
        manifest = json.loads((Path(sys.argv[3]) / "manifest.json").read_text())
        if git(Path(sys.argv[2]), "rev-parse", "refs/heads/main") != manifest["main"]:
            raise RuntimeError("Main advanced during deployment; retry coordination against the new integrated baseline")
        if source_tree(Path(sys.argv[2])) != manifest["tree"]:
            raise RuntimeError("Local source changed during deployment; hosts may differ")
    else:
        raise RuntimeError(f"Unknown mode: {mode}")


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, subprocess.CalledProcessError, OSError) as error:
        print(f"[Omarchy] {error}", file=sys.stderr, flush=True)
        sys.exit(1)
