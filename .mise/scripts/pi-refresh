#!/usr/bin/env bash
#MISE description="Refresh nix-managed pi packages for personal, work + notes profiles"
set -euo pipefail
umask 077
scripts_dir="$(cd "$(dirname "$0")" && pwd)"
if [ -z "${HARNESS_REFRESH_LOG_DIR:-}" ]; then
  state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/system-config/harness-refresh"
  mkdir -p "$state_dir"
  HARNESS_REFRESH_LOG_DIR="$(mktemp -d "$state_dir/$(date +%Y%m%d-%H%M%S).XXXXXX")"
fi
log_dir="$HARNESS_REFRESH_LOG_DIR"
# Audit once after reconciliation, not after every intermediate npm operation.
# Keep warnings enabled; raw output is retained in private per-profile logs.
export npm_config_audit=false npm_config_fund=false npm_config_progress=false
export npm_config_update_notifier=false NO_COLOR=1
printf 'Pi refresh logs: %s\n' "$log_dir"

pi_bin="$(which -a pi 2>/dev/null | grep -v '/.npm/_npx/' | head -n1)"
if [ -z "$pi_bin" ]; then
  echo "nix-managed pi not found in PATH" >&2
  exit 1
fi

# Git packages run npm inside their checkout. Prefer Nix's node/npm over mise
# shims there, which reject the freshly cloned (untrusted) mise.toml.
for nix_bin in "$HOME/.nix-profile/bin" "/etc/profiles/per-user/$USER/bin" /run/current-system/sw/bin; do
  if [ -x "$nix_bin/node" ] && [ -x "$nix_bin/npm" ]; then
    export PATH="$nix_bin:$PATH"
    break
  fi
done

# Retire only known former declarations in personal/notes. Preserve work,
# arbitrary packages, explicit resource references, credentials, and sessions.
retire_packages() {
  local profile_dir="$1"
  local label="$2"
  local retired name
  retired="$(python3 - "$profile_dir" "$label" <<'PY'
import json
import sys
from pathlib import Path

profile = Path(sys.argv[1])
manifest = profile / "npm/package.json"
if not manifest.exists():
    raise SystemExit(0)
settings = json.loads((profile / "settings.json").read_text())
declared = set()
for package in settings.get("packages", []):
    source = package if isinstance(package, str) else package.get("source", "")
    if not source.startswith("npm:"):
        continue
    spec = source.removeprefix("npm:")
    version_at = spec.find("@", 1)  # Preserve the leading @ in scoped names.
    declared.add(spec[:version_at] if version_at >= 0 else spec)
known_retired = {
    "personal": {
        "@samfp/pi-memory", "@tintinweb/pi-tasks", "@tmustier/pi-skill-creator",
        "context-mode", "pi-answer", "pi-ask-user", "pi-claude-bridge", "pi-intercom",
        "pi-mcp-adapter", "pi-subagents",
    },
    "notes": {
        "pi-claude-bridge", "pi-headroom", "pi-mcp-adapter",
        "pi-prompt-template-model", "pi-web-access",
    },
}.get(sys.argv[2], set())
# A package can also be used through an explicit local resource path. Do not
# retire it merely because its npm source no longer appears in packages.
references = []
for field in ("packages", "extensions", "skills", "prompts", "themes"):
    for entry in settings.get(field, []):
        source = entry if isinstance(entry, str) else entry.get("source", "")
        if source and not source.startswith(("npm:", "git:")):
            references.append(source)
installed = json.loads(manifest.read_text()).get("dependencies", {})
for name in sorted(known_retired.intersection(installed).difference(declared)):
    package = (profile / "npm/node_modules" / name).resolve()
    if any(Path(ref.lstrip("!+-")).expanduser().is_absolute() and
           Path(ref.lstrip("!+-")).expanduser().resolve().is_relative_to(package)
           or f"node_modules/{name}/" in ref + "/" for ref in references):
        continue
    print(name)
PY
  )" || return 1
  local -a packages=()
  while IFS= read -r name; do
    [ -n "$name" ] && packages+=("$name")
  done <<< "$retired"
  if [ -n "$retired" ]; then
    printf '[%s] Removing retired npm dependencies: %s\n' "$label" "${packages[*]}"
    PI_CODING_AGENT_DIR="$profile_dir" npm uninstall --prefix "$profile_dir/npm" --legacy-peer-deps "${packages[@]}" || return 1
  fi
}

# Pi install/update preserves valid lock resolutions. Refresh only transitive
# production dependencies within parent manifest ranges after reconciliation.
# Excluding direct names preserves Pi's pinned sources (npm install can save a
# caret range even for a pinned source). Never force upgrades or resolve peers.
refresh_dependencies() {
  local profile_dir="$1"
  local label="$2"
  local root="$3"
  [ -f "$root/package.json" ] || return 0
  printf '%s\n' "$root" >> "$log_dir/$label.roots"
  local dependency_list
  if ! dependency_list="$(python3 - "$root" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
manifest = json.loads((root / "package.json").read_text())
lock = json.loads((root / "package-lock.json").read_text())
direct = set()
for field in ("dependencies", "devDependencies", "optionalDependencies", "peerDependencies"):
    direct.update(manifest.get(field, {}))
transitive = set()
for path, metadata in lock["packages"].items():
    if "node_modules/" not in path or metadata.get("dev") or metadata.get("peer") or metadata.get("link"):
        continue
    name = path.rsplit("node_modules/", 1)[1]
    if name not in direct:
        transitive.add(name)
for name in sorted(transitive):
    print(name)
PY
  )"; then
    echo "[$label] Cannot read dependency lock for $root" >&2
    return 1
  fi
  local -a dependencies=()
  local name
  while IFS= read -r name; do
    [ -n "$name" ] && dependencies+=("$name")
  done <<< "$dependency_list"
  [ "${#dependencies[@]}" -gt 0 ] || return 0
  echo "[$label] Refreshing ${#dependencies[@]} semver-compatible transitive dependencies: $root"
  (
    # Keep lockfile paths relative to the installation root, not the caller.
    cd "$root" || exit 1
    PI_CODING_AGENT_DIR="$profile_dir" npm update --save=false --omit=dev --legacy-peer-deps --no-fund "${dependencies[@]}"
  )
}

refresh_profile() {
  local profile_dir="$1"
  local label="$2"
  local failure_file="$3"
  local marker="$profile_dir/packages-installed"
  local settings_file="$profile_dir/settings.json"

  local -a failures=()

  echo "[$label] Refreshing profile: $profile_dir"

  local -a git_packages=()
  local -a npm_packages=()
  if [ -f "$settings_file" ]; then
    local package_list
    if ! package_list="$(python3 - "$settings_file" <<'PY'
import json
import sys
from pathlib import Path

settings = Path(sys.argv[1])
try:
    data = json.loads(settings.read_text())
except json.JSONDecodeError as exc:
    print(
        f"Invalid JSON in {settings}: {exc}",
        file=sys.stderr,
    )
    sys.exit(1)

for package in data.get("packages", []):
    source = package if isinstance(package, str) else package.get("source", "")
    if source:
        print(source)
PY
    )"; then
      echo "[$label] Cannot read declared packages from $settings_file" >&2
      return 1
    fi

    while IFS= read -r package_source; do
      [ -n "$package_source" ] || continue
      case "$package_source" in
        git:*) git_packages+=("$package_source") ;;
        npm:*) npm_packages+=("$package_source") ;;
      esac
    done <<< "$package_list"
  fi

  retire_packages "$profile_dir" "$label" || return 1
  python3 "$scripts_dir/harness-report.py" policy "$profile_dir/npm" || return 1

  if [ ! -f "$marker" ]; then
    echo "[$label] Bootstrapping declared packages"
    PI_CODING_AGENT_DIR="$profile_dir" "$pi_bin" list >/dev/null
  fi

  for package_source in "${git_packages[@]}"; do
    echo "[$label] Refreshing declared git package: $package_source"
    # Native update installs a missing checkout and fetches only the selected
    # ref otherwise. Never delete/reclone a package just to check for updates.
    if PI_CODING_AGENT_DIR="$profile_dir" "$pi_bin" update "$package_source"; then
      :
    else
      failures+=("$label:$package_source")
    fi
  done

  for package_source in "${npm_packages[@]}"; do
    echo "[$label] Updating declared package: $package_source"
    if PI_CODING_AGENT_DIR="$profile_dir" "$pi_bin" update "$package_source"; then
      :
    else
      failures+=("$label:$package_source")
    fi
  done

  # Do not refresh a partially reconciled tree. Registry packages share a
  # profile-local npm root (including retained, inactive packages); Git package
  # roots are limited to declarations, not arbitrary cached checkouts.
  if [ "${#failures[@]}" -eq 0 ]; then
    if ! refresh_dependencies "$profile_dir" "$label" "$profile_dir/npm"; then
      failures+=("$label:npm-dependencies")
    fi
    for package_source in "${git_packages[@]}"; do
      git_path="${package_source#git:}"
      git_path="${git_path%@*}"
      git_path="${git_path%.git}"
      if ! refresh_dependencies "$profile_dir" "$label" "$profile_dir/git/$git_path"; then
        failures+=("$label:$package_source:dependencies")
      fi
    done
  fi

  if [ "${#failures[@]}" -gt 0 ]; then
    printf '%s\n' "${failures[@]}" > "$failure_file"
    return 1
  fi

  echo "[$label] Refreshed profile"
}

echo "Note: pi command is nix-managed here; wrapper resolves latest pi runtime automatically."

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

refresh_profile "$HOME/.config/pi" "personal" "$tmp_dir/personal.failures" > "$log_dir/personal.log" 2>&1 &
personal_pid=$!
refresh_profile "$HOME/.config/pi-work" "work" "$tmp_dir/work.failures" > "$log_dir/work.log" 2>&1 &
work_pid=$!
refresh_profile "$HOME/.config/pi-notes" "notes" "$tmp_dir/notes.failures" > "$log_dir/notes.log" 2>&1 &
notes_pid=$!

refresh_failed=0
wait "$personal_pid" || { refresh_failed=1; touch "$log_dir/personal.failed"; }
wait "$work_pid" || { refresh_failed=1; touch "$log_dir/work.failed"; }
wait "$notes_pid" || { refresh_failed=1; touch "$log_dir/notes.failed"; }

# pi install may register the notes git package in personal settings. Let the
# managed wrapper remove that stale registration after all refreshes finish.
PI_CODING_AGENT_DIR="$HOME/.config/pi" "$pi_bin" --help > "$log_dir/wrapper.log" 2>&1 || refresh_failed=1

# Findings are separate from installation success. Audit/network/report errors
# do fail the refresh, rather than silently claiming a clean dependency tree.
python3 "$scripts_dir/harness-report.py" report "$log_dir" || refresh_failed=1

if [ "$refresh_failed" -ne 0 ]; then
  printf 'Failed package updates:\n' >&2
  for failure_file in "$tmp_dir"/*.failures; do
    [ -s "$failure_file" ] || continue
    while IFS= read -r failure; do
      [ -n "$failure" ] || continue
      printf '  - %s\n' "$failure" >&2
    done < "$failure_file"
  done
  exit 1
fi


echo "Pi package updates completed; security findings are reported separately."
