#!/usr/bin/env bash
#MISE description="Refresh Pi packages and work Claude plugin on Mac, Omarchy, and Miller"
#USAGE flag "--local-only" help="Refresh only this host (macOS defaults to every host)"
set -uo pipefail

local_only="${usage_local_only:-false}"
# Also support direct invocation, without mise's usage parser.
if [ "${1:-}" = "--local-only" ]; then
  local_only=true
  shift
fi
if [ "$#" -ne 0 ]; then
  echo "Usage: harness-refresh [--local-only]" >&2
  exit 2
fi

scripts_dir="$(cd "$(dirname "$0")/../scripts" && pwd)"

# Omarchy (Arch) hosts refreshed from the Mac.
linux_hosts=(omarchy miller)
linux_labels=(Omarchy Miller)

refresh_linux() {
  local host="$1"
  # Ship only the refresh workers/report helper into a disposable directory.
  # This runs exactly
  # the same implementation without relying on/synchronizing the remote snapshot.
  # No credentials, profile config, or repository state crosses the SSH boundary.
  local payload
  if ! payload="$(COPYFILE_DISABLE=1 tar --format=ustar -C "$scripts_dir" -czf - harness-refresh-local pi-refresh harness-report.py | base64)"; then
    return 1
  fi
  {
    cat <<'BASH'
set -euo pipefail
if [ "$(uname -s)" != Linux ] || [ "$HOME" != /home/johna ] || [ "$(hostname -s)" != "$1" ]; then
  echo 'Unexpected Linux host/user; refusing refresh' >&2
  exit 1
fi
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT
base64 --decode <<'HARNESS_PAYLOAD' | tar -xzf - -C "$tmp_dir"
BASH
    printf '%s\n' "$payload"
    cat <<'BASH'
HARNESS_PAYLOAD
mise -C "$HOME/dev/src/amfaro" exec -- bash "$tmp_dir/harness-refresh-local"
BASH
  } | ssh -o BatchMode=yes -o ConnectTimeout=10 \
    -o ServerAliveInterval=15 -o ServerAliveCountMax=3 "johna@$host" bash -s "$host"
}

status=0
host="$(uname -s)"
printf '[%s] Refreshing local harness packages\n' "$host"
if mise -C "$HOME/dev/src/amfaro" exec -- bash "$scripts_dir/harness-refresh-local"; then
  printf '[%s] SUCCESS\n' "$host"
else
  printf '[%s] FAILED\n' "$host" >&2
  status=1
fi

# Linux is always host-local, preventing recursion and Mac rebuilds there.
# Attempt every Linux host even when an earlier refresh fails.
if [ "$host" = Darwin ] && [ "$local_only" != true ]; then
  for i in "${!linux_hosts[@]}"; do
    label="${linux_labels[$i]}"
    echo "[$label] Refreshing remote harness packages"
    if refresh_linux "${linux_hosts[$i]}"; then
      echo "[$label] SUCCESS"
    else
      echo "[$label] FAILED (shared refresh is partial)" >&2
      status=1
    fi
  done
fi

if [ "$status" -eq 0 ]; then
  echo 'All requested hosts refreshed; security findings (if any) are listed above.'
  echo 'Restart Claude Code on each refreshed host to load plugin updates; start a new Pi session for updated extensions.'
else
  echo 'Harness refresh incomplete; see per-host failures above.' >&2
fi
exit "$status"
