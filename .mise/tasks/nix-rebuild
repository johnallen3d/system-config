#!/usr/bin/env bash
#MISE description="Apply darwin-rebuild (updates flake by default); logs to temp file"
#USAGE flag "--switch-only" help="Skip nix flake update"
#USAGE flag "--picker-only" help="Update only the Herdr project picker input"
#USAGE flag "--update-only" help="Resolve inputs without building/applying (update-system preparation)"
set -uo pipefail

# Apply the invoking checkout, including linked worktrees, not unrelated main edits.
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo" || exit

if [[ "${usage_switch_only:-false}" == "true" && ( "${usage_picker_only:-false}" == "true" || "${usage_update_only:-false}" == "true" ) ]]; then
  echo "--switch-only cannot be combined with --picker-only or --update-only" >&2
  exit 2
fi

raise_nofile_limit() {
  local hard_limit
  hard_limit="$(ulimit -Hn)"
  ulimit -Sn "$hard_limit"
}

restart_service() {
  local service="$1"
  launchctl kickstart -k "gui/$(id -u)/org.nixos.${service}"
}

log="$(mktemp -t nix-rebuild.XXXXXX.log)"
printf 'nix-rebuild log: %s\n' "$log" >&2

(
  set -e
  # macOS launchd can leave GUI shells at maxfiles soft=256.
  # Raise to hard limit so flake input fetches do not hit tarball-cache EMFILE.
  raise_nofile_limit

  if [[ "${usage_picker_only:-false}" == "true" ]]; then
    nix flake update herdrProjectPicker
  elif [[ "${usage_switch_only:-false}" != "true" ]]; then
    nix flake update
  fi
  if [[ "${usage_update_only:-false}" != "true" ]]; then
    sudo -n /run/current-system/sw/bin/darwin-rebuild switch --impure --no-update-lock-file --no-write-lock-file --flake "path:$repo"
  fi
) >"$log" 2>&1
rc=$?

if [[ "$rc" -eq 0 && "${usage_update_only:-false}" != "true" ]]; then
  restart_service borders
fi

printf 'nix-rebuild log: %s (exit %d)\n' "$log" "$rc" >&2
exit "$rc"
