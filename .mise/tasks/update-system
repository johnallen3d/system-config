#!/usr/bin/env bash
#MISE description="Apply Mac, Omarchy, Miller, and Drummer config in parallel; optionally refresh harnesses"
#USAGE flag "--switch-only" help="Skip flake input updates on both hosts"
#USAGE flag "--local-only" help="Apply/refresh only the Mac; explicitly skip Omarchy, Miller, and Drummer"
#USAGE flag "--harness-refresh" help="Refresh Mac, Omarchy, Miller, and Drummer harness packages after all deployments succeed"
#USAGE flag "--harness-only" help="Refresh harness packages without rebuilding (Mac + Linux hosts from macOS)"
set -euo pipefail

refresh_harnesses() {
  if [[ "${usage_local_only:-false}" == true ]]; then
    mise run harness-refresh --local-only
  else
    mise run harness-refresh
  fi
}

if [[ "${usage_harness_only:-false}" == true ]]; then
  refresh_harnesses
  exit
fi

if [[ "$(uname -s)" != Darwin ]]; then
  echo "System deployments must start on macOS (Mac -> Omarchy, Miller, Drummer); use harness-refresh for host-local Linux refreshes" >&2
  exit 2
fi

tool_root="${SYSTEM_CONFIG_TOOL_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
repo="${SYSTEM_CONFIG_TASK_ROOT:-$tool_root}"
cd "$repo"

# One host-wide lock covers input resolution, every child, and provenance.
if [[ "${SYSTEM_CONFIG_COORDINATED:-}" != "$repo" ]]; then
  exec python3 "$tool_root/.mise/scripts/deployment_state.py" run "$repo" bash "${BASH_SOURCE[0]}" "$@"
fi
payload="$(mktemp -d)"
# Omarchy (Arch) hosts deployed from the Mac; each has homeConfigurations."johna@<host>".
linux_hosts=(omarchy miller drummer)
linux_labels=(Omarchy Miller Drummer)
linux_pids=()
cleanup() {
  trap '' INT TERM
  [[ -z "${mac_pid:-}" ]] || wait "$mac_pid" 2>/dev/null || true
  local pid
  for pid in ${linux_pids[@]+"${linux_pids[@]}"}; do wait "$pid" 2>/dev/null || true; done
  rm -rf "$payload"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

rebuild() {
  if [[ "$tool_root" == "$repo" ]]; then
    mise run nix-rebuild "$@"
  else
    # Installed tooling also coordinates older worktrees; never execute their
    # pre-coordinator rebuild script or mutate them to upgrade it.
    local switch=false update=false arg
    for arg in "$@"; do
      case "$arg" in
        --switch-only) switch=true ;;
        --update-only) update=true ;;
        *) return 2 ;;
      esac
    done
    usage_switch_only="$switch" usage_update_only="$update" \
      bash "$tool_root/.mise/tasks/nix-rebuild"
  fi
}

# Resolve inputs exactly once, before any host starts building.
if [[ "${usage_switch_only:-false}" != true ]]; then
  rebuild --update-only
fi

python3 "$tool_root/.mise/scripts/deployment_state.py" plan "$repo" "$payload/mac-source"
SYSTEM_CONFIG_SOURCE="$(<"$payload/mac-source")"
export SYSTEM_CONFIG_SOURCE

if [[ "${usage_local_only:-false}" == true ]]; then
  rebuild --switch-only
  python3 "$tool_root/.mise/scripts/deployment_state.py" finish "$repo"
  echo '[Mac] SUCCESS (Linux hosts explicitly skipped)'
else
  worker="$tool_root/.mise/scripts/update-system-omarchy"
  python3 "$worker" prepare "$repo" "$payload" "$SYSTEM_CONFIG_SOURCE"
  # The installed sudoers rule permits this exact command without a password.
  # A generic sudo -v would incorrectly demand unrelated authentication.
  sudo -n -l -- /run/current-system/sw/bin/darwin-rebuild switch --impure \
    --no-update-lock-file --no-write-lock-file --flake "path:$SYSTEM_CONFIG_SOURCE" >/dev/null || {
    auth_status=$?
    echo 'Command-specific darwin-rebuild sudo authorization is unavailable; no deployments started.' >&2
    exit "$auth_status"
  }
  echo "[Mac + $(IFS=,; echo "${linux_labels[*]}")] Starting parallel deployments"
  rebuild --switch-only &
  mac_pid=$!
  for host in "${linux_hosts[@]}"; do
    python3 "$worker" deploy "$payload" "$host" &
    linux_pids+=("$!")
  done
  status=0
  if wait "$mac_pid" && python3 "$tool_root/.mise/scripts/deployment_state.py" finish "$repo"; then
    echo '[Mac] SUCCESS'
  else
    mac_status=$?
    echo "[Mac] FAILED (exit $mac_status)" >&2
    status=1
  fi
  # Always collect every outcome, even when the Mac fails first.
  for i in "${!linux_hosts[@]}"; do
    label="${linux_labels[$i]}"
    if wait "${linux_pids[$i]}"; then
      echo "[$label] SUCCESS"
    else
      host_status=$?
      echo "[$label] FAILED (exit $host_status)" >&2
      status=1
    fi
  done
  if ! python3 "$worker" check "$repo" "$payload"; then
    status=1
  fi
  if [[ "$status" != 0 ]]; then
    echo 'Shared deployment is incomplete/partial; see per-host status and log paths above.' >&2
    exit "$status"
  fi
  echo "Mac, $(IFS=,; echo "${linux_labels[*]}") configurations applied and deployment source unchanged."
fi

if [[ "${usage_harness_refresh:-false}" == true ]]; then
  refresh_harnesses
fi
