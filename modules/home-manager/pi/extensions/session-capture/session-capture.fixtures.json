      "counts": {
        "## Pi Log": 0,
        "## Agent Log": 1
      }
    }
  },
  {
    "name": "duplicate bullet is unchanged",
    "kind": "upsert",
    "existingText": "# 2026-06-02\n\n## Agent Log\n\n- 09:00 AM \u2014 Worked on session-capture simplification\n",
    "blockLines": [
