    "value": "system-config-npsz Refactor Pi session capture around agent-authored summaries",
    "expected": {
      "summary": "captured issue system-config-npsz: Refactor Pi session capture around agent-authored summaries",
      "details": []
    }
  },
  {
    "name": "issue command without summary is rejected",
    "kind": "issue",
    "value": "system-config-npsz",
    "expected": null
  },
  {
    "name": "new daily note gets Agent Log heading",
    "kind": "upsert",
    "existingText": "# 2026-06-02\n\nExisting note\n",
    "blockLines": [
      "- 09:00 AM \u2014 Worked on session-capture simplification"
    ],
    "expected": {
      "changed": true,
      "contains": [
        "Existing note\n\n## Agent Log\n\n- 09:00 AM \u2014 Worked on session-capture simplification"
      ],
      "counts": {
        "## Agent Log": 1
      }
    }
  },
  {
    "name": "existing log appends one bullet",
    "kind": "upsert",
    "existingText": "# 2026-06-02\n\n## Agent Log\n\n- 08:00 AM \u2014 Earlier work #pi\n",
    "blockLines": [
      "- 09:00 AM \u2014 Worked on session-capture simplification"
    ],
    "expected": {
      "changed": true,
      "contains": [
        "- 08:00 AM \u2014 Earlier work #pi\n- 09:00 AM \u2014 Worked on session-capture simplification"
      ],
      "counts": {
        "## Agent Log": 1
      }
    }
  },
  {
    "name": "legacy Pi Log heading is renamed and stays separated from next heading",
    "kind": "upsert",
    "existingText": "# 2026-06-02\n\n## Pi Log\n\n## Misc\n",
    "blockLines": [
      "- 09:00 AM \u2014 Worked on session-capture simplification"
    ],
    "expected": {
